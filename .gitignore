# Full-repo Gemini XML dump (script/Export-GeminiSnapshot.ps1)
Gemini_Snapshot.txt
Gemini_Snapshot_*.txt

# Transient Gemini drop (keep README and empty dropzone marker)
doc/gemini/*
!doc/gemini/README.md
!doc/gemini/dropzone/
doc/gemini/dropzone/*
!doc/gemini/dropzone/.gitkeep

# Local compile counter. Never commit.
build_number.txt

# Handoff session notes. Ignore the files. Keep the directory by tracking README and the template.
.cursor/handoff/*
!.cursor/handoff/README.md
!.cursor/handoff/_template.md

doc/handoff/*
!doc/handoff/README.md
